# Track shared sources only; the submission archive and portable app stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/pyproject.toml
!/local.env.example
!/brain_of_cloud/
!/competition_eval/
!/scripts/
!/tests/
!/data/
!/docs/
!/.github/
!/sinanlike/

**/local.env
**/.env
**/.env.local
**/.env.*.local
**/*.sqlite*
**/*.db
**/*.db-journal
**/*.log
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/node_modules/
**/dist/
**/release/
**/build_res/
**/*.bak.*
**/.DS_Store
**/Thumbs.db
